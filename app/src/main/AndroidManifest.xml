<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application
    android:allowBackup="false"
    android:label="ForgeFit Preview 0.6"
    android:icon="@drawable/forgefit_icon"
    android:roundIcon="@drawable/forgefit_icon"
    android:supportsRtl="true"
    android:usesCleartextTraffic="false"
    android:theme="@style/ForgeFitTheme">
    <activity android:name="id.forgefit.app.MainActivity" android:exported="true" android:configChanges="orientation|screenSize|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
